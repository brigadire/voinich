  "seed_schedule": "SeedFor(base_seed=20260830, generator_id, \"SYNTHETIC-TOKEN\", \"CALIBRATION\", checkpoint, replicate_index)",
  "intended_preserved_properties": ["symbol frequency marginal (uniform)"],
  "intended_destroyed_properties": ["all sequence structure", "all token-internal structure beyond length"]
}
